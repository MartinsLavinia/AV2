
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// ENUMS
// ================================

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

// ================================
// ORGANIZACAO
// ================================

model Organizacao {
  id                 String   @id @default(uuid()) @db.Uuid
  razaoSocial        String
  cnpj               String   @unique
  inscricaoEstadual  String
  enderecoCompleto   String
  telefone           String
  email              String
  dataCadastro       DateTime @default(now())
  ativo              Boolean  @default(true)
  versao             Int      @default(1)

  contrato           Contrato?
  lotes              Lote[]
}

// ================================
// CONTRATO
// ================================

model Contrato {
  id                  String   @id @default(uuid()) @db.Uuid
  organizacaoId       String   @unique @db.Uuid
  dataAssinatura      DateTime
  dataVencimento      DateTime
  clausulas           String[]
  valorMensal         Decimal  @db.Decimal(10, 2)
  renovacaoAutomatica Boolean  @default(false)
  versao              Int      @default(1)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

// ================================
// LOTE
// ================================

model Lote {
  id                  String     @id @default(uuid()) @db.Uuid
  dataEntrada         DateTime   @default(now())
  organizacaoId       String     @db.Uuid
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote @default(RECEBIDO)
  observacoes         String
  versao              Int        @default(1)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  equipamentos Equipamento[]
}

// ================================
// EQUIPAMENTO
// ================================

model Equipamento {
  id                   String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno  String             @unique
  tipo                 TipoEquipamento
  marca                String
  modelo               String
  anoFabricacao        Int
  estadoFisico         EstadoFisico
  pesoQuilogramas      Float
  loteId               String             @db.Uuid
  posicaoNoLote        Int
  statusRastreamento   StatusRastreamento  @default(AGUARDANDO_TRIAGEM)
  versao               Int                @default(1)

  lote Lote @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  movimentacoes Movimentacao[]

  @@unique([loteId, posicaoNoLote])
}

// ================================
// MOVIMENTACAO
// ================================

model Movimentacao {
  id            String   @id @default(uuid()) @db.Uuid
  equipamentoId String   @db.Uuid
  dataHora      DateTime @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String
  versao        Int      @default(1)

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipamentoId, dataHora])
}
